<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_canvas"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/TitleNotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_new_note"
        android:textColor="@color/mw_ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@drawable/mw_surface_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/TitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:backgroundTint="@color/mw_primary"
            android:hint="@string/title_text"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:textColor="@color/mw_ink"
            android:textColorHint="@color/mw_muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/DescriptionText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:backgroundTint="@color/mw_primary"
            android:gravity="top|start"
            android:hint="@string/description_text"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingBottom="8dp"
            android:textColor="@color/mw_ink"
            android:textColorHint="@color/mw_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/SaveNote_Btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/save_note"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/mw_primary"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_round_add_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/white" />
</LinearLayout>
