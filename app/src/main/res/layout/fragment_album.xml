<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_canvas"
    tools:context=".frontend.home.fragments.AlbumFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photo_album"
            android:textColor="@color/mw_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/card_view_date_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/mw_surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/image_button_prev_date"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/content_previous_day"
                android:padding="8dp"
                android:src="@drawable/ic_round_back_24"
                app:tint="@color/mw_muted" />

            <TextView
                android:id="@+id/text_calendar_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/mw_ink"
                android:textSize="14sp"
                tools:text="Wednesday, Oct 13" />

            <ImageButton
                android:id="@+id/image_button_next_date"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/content_next_day"
                android:padding="8dp"
                android:rotation="180"
                android:src="@drawable/ic_round_back_24"
                android:visibility="invisible"
                app:tint="@color/mw_muted" />
        </LinearLayout>

        <GridView
            android:id="@+id/gridview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:horizontalSpacing="8dp"
            android:numColumns="3"
            android:paddingBottom="20dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wait_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3F6F7F4"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/wait_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wait"
            android:textColor="@color/mw_muted"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
