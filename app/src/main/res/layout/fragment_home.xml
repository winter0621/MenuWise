<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/mw_canvas" android:fillViewport="true" tools:context=".frontend.home.fragments.HomeFragment">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="100dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_greeting" android:textColor="@color/mw_ink" android:textSize="24sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/layout_date_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/image_button_prev_date" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="@string/content_previous_day" android:padding="8dp" android:src="@drawable/ic_round_back_24" app:tint="@color/mw_muted" />
            <TextView android:id="@+id/text_calendar_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/mw_muted" android:textSize="14sp" tools:text="Wednesday, Oct 13" />
            <ImageButton android:id="@+id/image_button_next_date" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="@string/content_next_day" android:padding="8dp" android:rotation="180" android:src="@drawable/ic_round_back_24" android:visibility="invisible" app:tint="@color/mw_muted" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/mw_primary_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
            <RelativeLayout android:layout_width="112dp" android:layout_height="112dp">
                <ProgressBar android:id="@+id/progress_home_circular" android:layout_width="112dp" android:layout_height="112dp" android:indeterminateOnly="false" android:progressDrawable="@drawable/dw_determinate_circular_progress" tools:progress="70" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/texT_progress_home" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold" tools:text="1,280" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/home_remaining_unit" android:textColor="@color/mw_primary_soft" android:textSize="10sp" />
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="每日计划" android:textColor="@color/mw_primary_soft" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="尚未设置目标" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:id="@+id/home_target_label" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="安排好每一餐" android:textColor="@color/mw_primary_soft" android:textSize="13sp" android:id="@+id/home_plan_summary" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_meal_plan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="安排每日饮食" android:textSize="16sp" app:cornerRadius="16dp" style="@style/Widget.MenuWise.Button" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_ai_calories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="AI 查询 · 了解食物热量" android:textAllCaps="false" android:textSize="16sp" app:cornerRadius="16dp" style="@style/Widget.MenuWise.Secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_record_meal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:contentDescription="@string/content_record_meal" android:text="记录实际食用量" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="16dp" style="@style/Widget.MenuWise.Secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_wellness_insights" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="健康洞察 · 近 7 天趋势" android:textAllCaps="false" android:textSize="16sp" app:cornerRadius="16dp" style="@style/Widget.MenuWise.Secondary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="所选日期的饮食记录" android:textColor="@color/mw_ink" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/home_meal_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:background="@drawable/mw_surface_card" android:layout_marginTop="12dp" android:textColor="@color/mw_ink" android:textSize="15sp" android:lineSpacingExtra="8dp" />
        <TextView android:id="@+id/home_budget_heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/home_budget_title" android:textColor="@color/mw_ink" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/home_budget_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_budget_note" android:textColor="@color/mw_muted" android:textSize="13sp" />
        <LinearLayout android:id="@+id/layout_components_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/mw_surface_card" android:elevation="2dp" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <include android:id="@+id/layout_cals_item" layout="@layout/layout_components_item" />
            <include android:id="@+id/layout_proteins_item" layout="@layout/layout_components_item" />
            <include android:id="@+id/layout_carbs_item" layout="@layout/layout_components_item" />
            <include android:id="@+id/layout_fats_item" layout="@layout/layout_components_item" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="最近拍照估算" android:textColor="@color/mw_ink" android:textSize="18sp" android:textStyle="bold" android:id="@+id/home_capture_heading" android:visibility="gone" />
        <LinearLayout android:id="@+id/card_last_captured" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/mw_surface_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp" android:visibility="gone">
            <ImageView android:id="@+id/image_last_captured" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@string/dish_image" android:scaleType="centerCrop" tools:src="@drawable/recipe_mixed_salad" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/text_last_captured" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_ink" android:textSize="16sp" android:textStyle="bold" tools:text="Chicken salad" />
                <TextView android:id="@+id/text_last_captured_placeholder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/last_tracked_image" android:textColor="@color/mw_muted" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
