<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_canvas"
    tools:context=".frontend.home.fragments.ReportsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_reports"
                android:textColor="@color/mw_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_date_container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/mw_surface_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageButton
                    android:id="@+id/image_button_prev_date"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/content_previous_day"
                    android:padding="8dp"
                    android:src="@drawable/ic_round_back_24"
                    app:tint="@color/mw_muted" />

                <TextView
                    android:id="@+id/text_calendar_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/mw_ink"
                    android:textSize="14sp"
                    tools:text="7 - 13 Oct 2026" />

                <ImageButton
                    android:id="@+id/image_button_next_date"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/content_next_day"
                    android:padding="8dp"
                    android:rotation="180"
                    android:src="@drawable/ic_round_back_24"
                    android:visibility="invisible"
                    app:tint="@color/mw_muted" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/total_nutrition_title"
                android:textColor="@color/mw_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_components_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/mw_surface_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <include android:id="@+id/layout_cals_item" layout="@layout/layout_components_item" />
                <include android:id="@+id/layout_proteins_item" layout="@layout/layout_components_item" />
                <include android:id="@+id/layout_carbs_item" layout="@layout/layout_components_item" />
                <include android:id="@+id/layout_fats_item" layout="@layout/layout_components_item" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/report_card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/mw_soft_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/report_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_title"
                    android:textColor="@color/mw_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/report_weight_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/mw_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/report_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mw_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="0.3 KG" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#80A4CDB4" />

                <TextView
                    android:id="@+id/report_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mw_ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/report_next_days_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/mw_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/wait_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3F6F7F4"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/wait_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wait"
            android:textColor="@color/mw_muted"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
