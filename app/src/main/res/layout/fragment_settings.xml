<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/mw_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/mw_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mw_surface_card"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_offline_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_offline_mode"
                android:textColor="@color/mw_ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_mode_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/mw_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_services"
            android:textColor="@color/mw_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/mw_surface_card"
            android:orientation="vertical">

            <TextView android:id="@+id/row_ai_service" style="@style/MenuWise.SettingsRow" android:text="@string/settings_ai_service" />
            <View style="@style/MenuWise.SettingsDivider" />
            <TextView android:id="@+id/row_household_profiles" style="@style/MenuWise.SettingsRow" android:text="家庭饮食档案" />
            <View style="@style/MenuWise.SettingsDivider" />
            <TextView android:id="@+id/row_reminder" style="@style/MenuWise.SettingsRow" android:text="@string/settings_reminders" />
            <View style="@style/MenuWise.SettingsDivider" />
            <TextView android:id="@+id/row_language" style="@style/MenuWise.SettingsRow" android:text="@string/settings_language" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_about"
            android:textColor="@color/mw_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/mw_surface_card"
            android:orientation="vertical">

            <TextView android:id="@+id/row_privacy" style="@style/MenuWise.SettingsRow" android:text="@string/settings_privacy" />
            <View style="@style/MenuWise.SettingsDivider" />
            <TextView
                android:id="@+id/text_version"
                style="@style/MenuWise.SettingsRow"
                android:clickable="false"
                android:focusable="false"
                android:text="@string/settings_version" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
