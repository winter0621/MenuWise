<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/user_goal_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/mw_canvas" tools:context=".frontend.authentication.fragments.UserGoalFragment">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:id="@+id/fragment_view" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="28dp" android:paddingTop="28dp" android:paddingEnd="28dp" android:paddingBottom="28dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/user_goal" android:textColor="@color/mw_ink" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/user_goal_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/future_goal" android:textColor="@color/mw_muted" android:textSize="14sp" />
            <ProgressBar android:id="@+id/phase3_progress_bar" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="16dp" android:max="90" android:progress="90" android:progressTint="@color/mw_primary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/mw_surface_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/goal_desired_weight_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/desired_weight_km" app:boxBackgroundMode="outline" app:boxStrokeColor="@color/mw_primary"><com.google.android.material.textfield.TextInputEditText android:id="@+id/goal_desired_weight" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/mw_ink" android:textSize="16sp" /></com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/future_goal_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/future_goal" android:textColor="@color/mw_ink" android:textSize="15sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/goal_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical">
                    <RadioButton android:id="@+id/goal_lose_weight" android:layout_width="match_parent" android:layout_height="48dp" android:buttonTint="@color/mw_primary" android:gravity="center_vertical" android:text="@string/lose_weight" android:textColor="@color/mw_ink" />
                    <RadioButton android:id="@+id/goal_gain_weight" android:layout_width="match_parent" android:layout_height="48dp" android:buttonTint="@color/mw_primary" android:gravity="center_vertical" android:text="@string/gain_weight" android:textColor="@color/mw_ink" />
                    <RadioButton android:id="@+id/goal_fitness_tracker" android:layout_width="match_parent" android:layout_height="48dp" android:buttonTint="@color/mw_primary" android:gravity="center_vertical" android:text="@string/fitness_tracker" android:textColor="@color/mw_ink" />
                    <RadioButton android:id="@+id/goal_patient_treatment" android:layout_width="match_parent" android:layout_height="48dp" android:buttonTint="@color/mw_primary" android:gravity="center_vertical" android:text="@string/patient_treatment" android:textColor="@color/mw_ink" />
                </RadioGroup>
            </LinearLayout>
            <ProgressBar android:id="@+id/goal_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/transition_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                <com.makeramen.roundedimageview.RoundedImageView android:id="@+id/back_icon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/content_go_back" android:rotationY="180" android:src="@drawable/next_icon" />
                <com.google.android.material.button.MaterialButton android:id="@+id/final_register" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="16dp" android:layout_weight="1" android:text="@string/register" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" app:backgroundTint="@color/mw_primary" app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include android:id="@+id/goal_error_view" layout="@layout/layout_error_custom_view" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
