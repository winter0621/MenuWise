<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/user_info_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/mw_canvas" tools:context=".frontend.authentication.fragments.UserInfoFragment">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:id="@+id/fragment_view" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="28dp" android:paddingTop="28dp" android:paddingEnd="28dp" android:paddingBottom="28dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/user_info" android:textColor="@color/mw_ink" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/user_info_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/user_data" android:textColor="@color/mw_muted" android:textSize="14sp" />
            <ProgressBar android:id="@+id/phase2_progress_bar" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="16dp" android:max="90" android:progress="60" android:progressTint="@color/mw_primary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/mw_surface_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/info_height_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/height_cm" app:boxBackgroundMode="outline" app:boxStrokeColor="@color/mw_primary"><com.google.android.material.textfield.TextInputEditText android:id="@+id/info_height" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/mw_ink" android:textSize="16sp" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/info_weight_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/weight_km" app:boxBackgroundMode="outline" app:boxStrokeColor="@color/mw_primary"><com.google.android.material.textfield.TextInputEditText android:id="@+id/info_weight" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/mw_ink" android:textSize="16sp" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/info_age_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/age" app:boxBackgroundMode="outline" app:boxStrokeColor="@color/mw_primary"><com.google.android.material.textfield.TextInputEditText android:id="@+id/info_age" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="@color/mw_ink" android:textSize="16sp" /></com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/info_gender_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/gender" android:textColor="@color/mw_ink" android:textSize="15sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/info_gender_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <RadioButton android:id="@+id/info_male" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:buttonTint="@color/mw_primary" android:gravity="center_vertical" android:text="@string/male" android:textColor="@color/mw_ink" />
                    <RadioButton android:id="@+id/info_female" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:buttonTint="@color/mw_primary" android:gravity="center_vertical" android:text="@string/female" android:textColor="@color/mw_ink" />
                </RadioGroup>
            </LinearLayout>
            <include android:id="@+id/info_transition" layout="@layout/layout_transition_custom_buttons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <include android:id="@+id/info_error_view" layout="@layout/layout_error_custom_view" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
