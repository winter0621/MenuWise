# 通用 OpenAI 兼容接口。默认 DeepSeek，只需填 Key；模型须已开通。
MENUWISE_API_KEY=replace-with-your-key
MENUWISE_API_URL=https://api.deepseek.com/chat/completions
MENUWISE_TEXT_MODEL=deepseek-flash
MENUWISE_VISION_MODEL=deepseek-flash
# DeepSeek：API_URL=https://api.deepseek.com，两个 MODEL 均可使用 deepseek-flash。
# 其他兼容接口：填写基础地址或完整 chat/completions 地址与模型名。
# 不支持图片时将 MENUWISE_VISION_MODEL 留空。
# 用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成后端访问码。
MENUWISE_ACCESS_TOKEN=replace-with-a-random-token-at-least-32-characters
MENUWISE_DAILY_LIMIT=200
